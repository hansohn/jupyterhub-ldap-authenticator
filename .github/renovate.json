{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "labels": [
    "auto-update"
  ],
  "enabledManagers": [
    "pep621",
    "pip_requirements",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned tool versions declared in workflow env blocks",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION: '(?<currentValue>[^']+)'"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Python 3.15 is tested in CI only. Do not propose it as the baseline.",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
