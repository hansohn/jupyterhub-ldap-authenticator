{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges"
  ],
  "labels": [
    "auto-update"
  ],
  "enabledManagers": [
    "pep621",
    "pip_requirements",
    "github-actions",
    "dockerfile",
    "docker-compose"
  ],
  "packageRules": [
    {
      "description": "Python 3.15 is tested in CI only. Do not propose it as the baseline.",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
